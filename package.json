{
  "name": "hackathon-project",
  "private": true,
  "version": "0.0.0",
  "description": "Project Lens helps developers understand AI-generated software projects.",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,blue \"npm run daemon\" \"npm run dev:web\"",
    "dev:web": "vite",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "website:lint": "npm --prefix website run lint",
    "website:test": "npm --prefix website run test",
    "website:preview": "npm --prefix website run preview",
    "daemon": "tsx src/local-api/server.ts",
    "project-lens": "tsx src/local-api/cli.ts",
    "artifact:audit": "tsx src/local-api/artifactAudit.ts",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/doctor-project-lens.ps1",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run --exclude \"**/.project-lens/**\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
