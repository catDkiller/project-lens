{
  "name": "hackathon-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,blue \"npm run daemon\" \"npm run dev:web\"",
    "dev:web": "vite",
    "daemon": "tsx src/local-api/server.ts",
    "project-lens": "tsx src/local-api/cli.ts",
    "artifact:audit": "tsx src/local-api/artifactAudit.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run --exclude \"**/.project-lens/**\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
